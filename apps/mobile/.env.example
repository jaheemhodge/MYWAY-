# Copy to .env.local (git-ignored) and fill in from Supabase → Project Settings → API.
# Only the anon (public) key belongs here. Never put the service_role key in the client.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Show the "Continue with Google" button (needs the Google provider enabled in Supabase Auth).
VITE_ENABLE_GOOGLE=false

# Legacy research API for the phone prototype (optional).
VITE_API_URL=http://localhost:8000
VITE_DEMO_MODE=true
