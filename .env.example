# Server-only billing. Never prefix these with VITE_ and never commit real values.
# Checkout refuses a secret that does not start with sk_test_ (see STRIPE_TEST_MODE_ONLY).
# Full access is $9.99 USD / month. STRIPE_PRICE_ID selects that Stripe Price.

STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET
STRIPE_WEBHOOK_SECRET=whsec_YOUR_TEST_WEBHOOK_SECRET
STRIPE_PRICE_ID=price_YOUR_TEST_PRICE
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional. When unset, success and cancel URLs use the request's forwarded host.
# APP_URL=https://your-preview.example
